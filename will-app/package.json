{
  "name": "will-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "test:w1:browser": "node tests/w1.browser.cjs",
    "test:w1:desktop": "node tests/w1.desktop.cjs",
    "preview": "vite preview",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "tsc -b && vite build --mode desktop",
    "desktop:start": "electron .",
    "desktop:package": "npm run desktop:build && node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.8",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.2.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
